// Test Case: Fourier Transform of a Periodic Impulse Train (SCILAB)
clear; clc;

// Define time range and sampling interval
t_min = -5;  // Start time
t_max = 5;   // End time
dt = 0.01;   // Time step
t = t_min:dt:t_max; // Time vector

// Define the periodic impulse train
T = 1; // Period of the impulse train
A = 1; // Amplitude of the impulses

// Impulse train creation with tolerance
x_t = A * (abs(pmodulo(t + T/2, T) - T/2) < 1e-6);

// Compute the Fourier Transform using FFT
X_f = fft(x_t); // Compute FFT of the signal
N = length(t);  // Number of points in FFT
f = linspace(-1/(2*dt), 1/(2*dt), N); // Frequency vector

// Shift zero frequency component to the center
X_f_shifted = fftshift(X_f);
magnitude_X_f = abs(X_f_shifted) / N; // Magnitude of the Fourier Transform

// Phase of the Fourier Transform
phase_X_f = atan(imag(X_f_shifted), real(X_f_shifted)); 

// Plotting
clf(); // Clear current graphics window

// Plot the original periodic impulse train
subplot(3,1,1);
plot(t, x_t, 'b');
xlabel('t (Time)');
ylabel('Amplitude');
title('Periodic Impulse Train');
xgrid();

// Plot the magnitude of the Fourier Transform
subplot(3,1,2);
plot(f, magnitude_X_f, 'r');
xlabel('f (Frequency)');
ylabel('|X(f)|');
title('Magnitude of the Fourier Transform');
xgrid();

// Plot the phase of the Fourier Transform
subplot(3,1,3);
plot(f, phase_X_f, 'g');
xlabel('f (Frequency)');
ylabel('Phase of X(f)');
title('Phase of the Fourier Transform');
xgrid();
